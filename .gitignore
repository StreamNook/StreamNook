# Dependencies
node_modules/

# Production
dist/
src-tauri/target/

# Dev-only schema scraper + its scraped reference dumps (regenerable, not shipped)
/tools/

# Tauri auto-generated schemas (regenerated on every build)
src-tauri/gen/schemas/
scripts/*

# Documentation: scratch docs stay untracked, but the frozen plugin-system spec
# is versioned with the code that implements it.
docs/*
!docs/plugins/

# Drops folder (local mining tool) - only root level, not src/components/drops
/drops/

# Plugin source trees (developed here, shipped as signed artifacts through the
# plugins index - not bundled with or pushed to the app repo). Root-level only,
# so src/components/drops and docs/plugins are unaffected.
/plugins/

# Streamlink portable (for development - bundled in production releases)
/streamlink/

# Update artifacts
update_streamnook.bat
StreamNook_new.exe

# Release artifacts (only uploaded to GitHub releases, not committed)
*.7z
checksums.txt
StreamNook.exe

# Documentation
RELEASE.md

# Environment variables
.env
.env.local
.env.*.local

# Supabase local CLI scaffolding (migrations, edge functions, link state) -
# backend lives with the Supabase project, not the desktop app repo.
supabase/

# System
.DS_Store
Thumbs.db

# Wrangler / Cloudflare local dev cache (streamnook.app tooling)
.wrangler/

# Android port: Windows-only bare-clang linker workaround (breaks the Linux build).
# The repo-root one is the Windows hack; src-tauri/.cargo/config.toml is tracked
# because it carries the Android strip flags.
/.cargo/

# Android port: generated/local Gradle state
src-tauri/gen/android/local.properties
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/build/
badge-assets-r2/
atmosphere-assets-r2/

# Generated from potoken/mint.mjs by `npm run build:potoken`, and regenerated by
# src-tauri/build.rs when it is missing or stale. ~700KB of minified output that
# rewrites wholesale on any source edit, so it is built rather than committed.
src-tauri/potoken/mint.bundle.js

# Android release signing. Never commit: the keystore and its passwords are
# the app identity, and a leaked one lets anyone ship an update as StreamNook.
keystore.properties
*.jks
*.keystore
