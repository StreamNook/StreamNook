{
  "name": "streamnook",
  "version": "8.6.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "predev": "npm run build:potoken",
    "dev": "vite",
    "devtools": "react-devtools",
    "dev:debug": "concurrently \"npm run devtools\" \"npm run tauri dev\" --names \"DevTools,Tauri\" --prefix-colors \"blue,green\"",
    "prebuild": "npm run build:potoken",
    "build": "tsc && vite build",
    "build:potoken": "esbuild src-tauri/potoken/mint.mjs --bundle --format=iife --platform=browser --target=chrome110 --minify --outfile=src-tauri/potoken/mint.bundle.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "ship": "powershell -ExecutionPolicy Bypass -File ./scripts/release_manager.ps1",
    "update-deps": "powershell -ExecutionPolicy Bypass -File ./scripts/update-dependencies.ps1",
    "update-deps:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/update-dependencies.ps1 -Auto"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "autoprefixer": "^10.5.4",
    "framer-motion": "^13.2.0",
    "gifenc": "^1.0.3",
    "hls.js": "^1.7.2",
    "lucide-react": "^0.563.0",
    "nspell": "^2.1.5",
    "phosphor-react": "^1.4.1",
    "plyr": "^3.8.4",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.21",
    "bgutils-js": "^4.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "node-webpmux": "^3.2.1",
    "puppeteer": "^25.10.0",
    "react-devtools": "^7.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "youtubei.js": "^18.0.0"
  }
}
