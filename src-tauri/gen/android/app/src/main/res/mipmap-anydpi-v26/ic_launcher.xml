<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Brushed gunmetal plate, one per density, generated by
       scripts/gen-android-icons.py. Was a flat @color (#fff), then a violet
       gradient shape; both are gone. Regenerate with that script rather than
       hand-editing the PNGs, and re-run it after any `tauri android init`. -->
  <background android:drawable="@drawable/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <!-- Themed-icon support (Android 13+): the launcher flat-tints this to the
       user's wallpaper palette and supplies its own ground.
       It MUST be the dedicated silhouette, not the colour foreground. Every
       cube face in the mark is fully opaque, so tinting the colour art
       collapsed the Penrose triangle into a solid blob - the illusion is
       carried entirely by the three face shades and tinting discards all of
       them. The silhouette encodes those shades as ALPHA, which survives. -->
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>