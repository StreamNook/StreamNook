{
  "about": "Golden cases for the mention rule. Each message is the raw PRIVMSG trailing text with its reply-parent tags; the runner normalizes it, then judges it for the user. expect is mention, reply or null. Both the app and the mention watcher run this file.",
  "users": {
    "brandon": { "id": "100", "login": "brandon", "display": "Brandon" },
    "winters": { "id": "200", "login": "br_winters", "display": "Winters" },
    "korean": { "id": "300", "login": "brandon_kr", "display": "브랜든" }
  },
  "cases": [
    { "name": "at login", "user": "brandon", "from": ["2", "alice", "alice"], "text": "hey @brandon", "expect": "mention" },
    { "name": "at login, other case", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@BRANDON gg", "expect": "mention" },
    { "name": "at login, punctuation after", "user": "brandon", "from": ["2", "alice", "alice"], "text": "nice one @Brandon!", "expect": "mention" },
    { "name": "at login, longer word", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@brandons stream", "expect": null },
    { "name": "at login, underscore after", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@brandon_ hi", "expect": null },
    { "name": "at login, glued on the left still counts", "user": "brandon", "from": ["2", "alice", "alice"], "text": "x@brandon", "expect": "mention" },
    { "name": "bare login", "user": "brandon", "from": ["2", "alice", "alice"], "text": "brandon nice play", "expect": "mention" },
    { "name": "bare login, sentence end", "user": "brandon", "from": ["2", "alice", "alice"], "text": "gg, Brandon.", "expect": "mention" },
    { "name": "bare login inside a word", "user": "brandon", "from": ["2", "alice", "alice"], "text": "xbrandon is here", "expect": null },
    { "name": "bare login plural", "user": "brandon", "from": ["2", "alice", "alice"], "text": "brandons everywhere", "expect": null },
    { "name": "bare login after an embedded copy", "user": "brandon", "from": ["2", "alice", "alice"], "text": "brandons and brandon", "expect": "mention" },
    { "name": "bare login off", "user": "brandon", "opts": { "bare_login": false, "display_name": true }, "from": ["2", "alice", "alice"], "text": "brandon nice play", "expect": null },
    { "name": "bare login off, at login still counts", "user": "brandon", "opts": { "bare_login": false, "display_name": false }, "from": ["2", "alice", "alice"], "text": "@brandon nice play", "expect": "mention" },
    { "name": "display name", "user": "winters", "from": ["2", "alice", "alice"], "text": "hi winters", "expect": "mention" },
    { "name": "display name with at", "user": "winters", "from": ["2", "alice", "alice"], "text": "hi @Winters", "expect": "mention" },
    { "name": "display name off", "user": "winters", "opts": { "bare_login": true, "display_name": false }, "from": ["2", "alice", "alice"], "text": "hi winters", "expect": null },
    { "name": "login of a display-name user", "user": "winters", "from": ["2", "alice", "alice"], "text": "br_winters hi", "expect": "mention" },
    { "name": "display name inside a word", "user": "winters", "from": ["2", "alice", "alice"], "text": "wintersun tour", "expect": null },
    { "name": "non-ASCII display name in unspaced text", "user": "korean", "from": ["2", "alice", "alice"], "text": "안녕브랜든님", "expect": "mention" },
    { "name": "non-ASCII display name absent", "user": "korean", "from": ["2", "alice", "alice"], "text": "こんにちは", "expect": null },
    { "name": "nobody named", "user": "brandon", "from": ["2", "alice", "alice"], "text": "what a game", "expect": null },
    { "name": "empty text", "user": "brandon", "from": ["2", "alice", "alice"], "text": "", "expect": null },
    { "name": "/me naming you", "user": "brandon", "from": ["2", "alice", "alice"], "text": "\u0001ACTION waves at brandon\u0001", "expect": "mention" },
    { "name": "/me without you", "user": "brandon", "from": ["2", "alice", "alice"], "text": "\u0001ACTION waves\u0001", "expect": null },
    { "name": "reply to you", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@Brandon agreed", "reply": ["100", "brandon", "Brandon"], "expect": "reply" },
    { "name": "reply to you without your name", "user": "brandon", "from": ["2", "alice", "alice"], "text": "agreed", "reply": ["100", "brandon", "Brandon"], "expect": "reply" },
    { "name": "reply to someone else named like you is stripped", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@brandon_fan lol", "reply": ["9", "brandon_fan", "brandon_fan"], "expect": null },
    { "name": "reply to someone else, your login is their display name", "user": "winters", "from": ["2", "alice", "alice"], "text": "@Winters true", "reply": ["9", "other_winters", "Winters"], "expect": null },
    { "name": "reply to someone else that names you after", "user": "brandon", "from": ["2", "alice", "alice"], "text": "@carl ask brandon", "reply": ["9", "carl", "Carl"], "expect": "mention" },
    { "name": "reply to someone else, localized parent stripped", "user": "korean", "from": ["2", "alice", "alice"], "text": "@브랜든 ㅋㅋ", "reply": ["9", "someone", "브랜든"], "expect": null },
    { "name": "/me reply to you", "user": "brandon", "from": ["2", "alice", "alice"], "text": "\u0001ACTION @Brandon nods\u0001", "reply": ["100", "brandon", "Brandon"], "expect": "reply" },
    { "name": "own message naming yourself", "user": "brandon", "from": ["100", "brandon", "Brandon"], "text": "@brandon testing", "expect": null },
    { "name": "own message, id differs but login is yours", "user": "brandon", "from": ["", "Brandon", "Brandon"], "text": "me, brandon", "expect": null },
    { "name": "own reply to yourself", "user": "brandon", "from": ["100", "brandon", "Brandon"], "text": "@brandon again", "reply": ["100", "brandon", "Brandon"], "expect": null },
    { "name": "known bot", "user": "brandon", "from": ["5", "nightbot", "Nightbot"], "text": "@brandon follow the rules", "expect": null },
    { "name": "known bot by display name", "user": "brandon", "from": ["5", "sb_relay", "StreamElements"], "text": "thanks brandon", "expect": null },
    { "name": "hidden by login", "user": "brandon", "hidden": ["carl"], "from": ["6", "Carl", "Carl"], "text": "@brandon hi", "expect": null },
    { "name": "hidden by user id", "user": "brandon", "hidden": ["6"], "from": ["6", "carl", "carl"], "text": "@brandon hi", "reply": ["100", "brandon", "Brandon"], "expect": null },
    { "name": "hidden list does not hide others", "user": "brandon", "hidden": ["carl"], "from": ["7", "dave", "dave"], "text": "@brandon hi", "expect": "mention" },
    { "name": "trailing whitespace ignored", "user": "brandon", "from": ["2", "alice", "alice"], "text": "gg brandon   ", "expect": "mention" }
  ]
}
