{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "scope": {
          "allow": [
            "$LOCALDATA/StreamNook/cache/universal/badges/*",
            "$LOCALDATA/StreamNook/cache/universal/emotes/*",
            "$LOCALDATA/StreamNook/cache/universal/third-party-badges/*",
            "$LOCALDATA/StreamNook/cache/universal/cosmetics/*",
            "$LOCALDATA/StreamNook/cache/universal/streamnook-art/*",
            "$LOCALDATA/StreamNook/image_uploads/files/*",
            "$LOCALDATA/StreamNook/image_uploads/thumbs/*",
            "$LOCALDATA/StreamNook/sounds/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/badges/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/emotes/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/third-party-badges/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/cosmetics/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/streamnook-art/*",
            "$LOCALDATA/com.streamnook.dev/image_uploads/files/*",
            "$LOCALDATA/com.streamnook.dev/image_uploads/thumbs/*",
            "$LOCALDATA/com.streamnook.dev/sounds/*",
            "$APPDATA/StreamNook/cache/universal/badges/*",
            "$APPDATA/StreamNook/cache/universal/emotes/*",
            "$APPDATA/StreamNook/cache/universal/third-party-badges/*",
            "$APPDATA/StreamNook/cache/universal/cosmetics/*",
            "$APPDATA/StreamNook/cache/universal/streamnook-art/*",
            "$APPDATA/StreamNook/image_uploads/files/*",
            "$APPDATA/StreamNook/image_uploads/thumbs/*",
            "$APPDATA/StreamNook/sounds/*"
          ],
          "deny": [
            "$LOCALDATA/StreamNook/*",
            "$LOCALDATA/StreamNook/.*",
            "$LOCALDATA/StreamNook/cache/*",
            "$LOCALDATA/StreamNook/cache/universal/*",
            "$LOCALDATA/StreamNook/image_uploads/*",
            "$LOCALDATA/com.streamnook.dev/*",
            "$LOCALDATA/com.streamnook.dev/.*",
            "$LOCALDATA/com.streamnook.dev/cache/*",
            "$LOCALDATA/com.streamnook.dev/cache/universal/*",
            "$LOCALDATA/com.streamnook.dev/image_uploads/*",
            "$APPDATA/StreamNook/*",
            "$APPDATA/StreamNook/.*",
            "$APPDATA/StreamNook/cache/*",
            "$APPDATA/StreamNook/cache/universal/*",
            "$APPDATA/StreamNook/image_uploads/*"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "StreamNook",
        "width": 1600,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "visible": false,
        "backgroundColor": "#0c0c0d",
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Video",
    "shortDescription": "Watch and chat on Twitch, Kick and YouTube",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
