{
  "$schema": "../gen/schemas/desktop_capability.json",
  "identifier": "remote-bridge-capability",
  "description": "The only native surface reachable from the remote twitch.tv, kick.com and youtube.com pages StreamNook loads in its hidden and overlay webviews. Everything else is denied to those origins.",
  "windows": [
    "whisper-scraper",
    "identity-fetch-*",
    "identity-update-*",
    "twitch-login",
    "drops-login",
    "subscribe-*",
    "kick-resolve-*",
    "kick-sync-*",
    "kick-login",
    "youtube-login"
  ],
  "remote": {
    "urls": [
      "https://twitch.tv/*",
      "https://*.twitch.tv/*",
      "https://kick.com/*",
      "https://*.kick.com/*",
      "https://youtube.com/*",
      "https://*.youtube.com/*",
      "https://accounts.google.com/*"
    ]
  },
  "permissions": [
    "remote-bridge"
  ]
}
