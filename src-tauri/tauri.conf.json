{
  "productName": "StreamNook",
  "version": "8.7.1",
  "identifier": "com.streamnook.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src * data: blob: filesystem: about: ws: wss: http: https: tauri: asset:; script-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; connect-src * http: https: ws: wss: ipc: http://ipc.localhost; img-src * data: blob: asset: http://asset.localhost; frame-src *; style-src * 'unsafe-inline'; media-src * blob: data: asset: http://asset.localhost http: https:;",
      "capabilities": [
        "main-capability",
        "mobile-capability",
        "remote-bridge-capability"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "StreamNook",
        "width": 1600,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "visible": false,
        "backgroundColor": "#0c0c0d"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["streamnook"]
      }
    }
  }
}
